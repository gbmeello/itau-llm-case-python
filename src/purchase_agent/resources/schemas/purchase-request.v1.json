{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itau-case/schemas/purchase-request.v1.json",
  "title": "PurchaseRequest v1",
  "description": "Solicitação de compra. Só o mínimo é obrigatório; lacunas são tratadas pelo intake e viram dataQuality/missingInformation.",
  "type": "object",
  "required": ["requestId", "requester", "items"],
  "properties": {
    "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
    "requestedAt": { "type": ["string", "null"] },
    "requester": {
      "type": "object",
      "required": ["costCenter"],
      "properties": {
        "employeeId": { "type": ["string", "null"], "maxLength": 64 },
        "name": { "type": ["string", "null"], "maxLength": 200 },
        "department": { "type": ["string", "null"], "maxLength": 100 },
        "costCenter": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "supplier": {
      "type": ["object", "null"],
      "properties": {
        "taxId": { "type": ["string", "null"], "maxLength": 32 },
        "name": { "type": ["string", "null"], "maxLength": 200 }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "sku": { "type": ["string", "null"], "maxLength": 64 },
          "description": { "type": ["string", "null"], "maxLength": 500 },
          "category": { "type": ["string", "null"], "maxLength": 64 },
          "quantity": { "type": ["integer", "null"], "minimum": 0 },
          "unitPrice": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "totalAmount": { "type": ["number", "null"], "minimum": 0 },
    "currency": { "type": ["string", "null"], "maxLength": 8 },
    "justification": { "type": ["string", "null"], "maxLength": 4000 },
    "neededBy": { "type": ["string", "null"] },
    "urgency": { "type": ["string", "null"], "maxLength": 32 }
  }
}
