{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://itau-case/schemas/purchase-decision.v1.json",
  "title": "PurchaseDecision v1",
  "type": "object",
  "required": ["schemaVersion", "requestId", "decision", "riskLevel", "riskScore", "confidence", "summary",
               "reasons", "policyChecks", "missingInformation", "dataQuality", "evidence", "erpPayload", "audit"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "requestId": { "type": "string" },
    "caseId": { "type": ["string", "null"] },
    "decision": { "enum": ["APPROVE", "REJECT", "ESCALATE_TO_HUMAN", "NEEDS_INFO"] },
    "riskLevel": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "riskScore": { "type": "integer", "minimum": 0, "maximum": 100 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "reasons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "explanation", "evidenceIds"],
        "properties": {
          "code": { "type": "string" },
          "severity": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
          "explanation": { "type": "string" },
          "evidenceIds": { "type": "array", "items": { "type": "string", "pattern": "^EV-[A-Z0-9-]+$" } }
        }
      }
    },
    "policyChecks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["policyId", "result", "source"],
        "properties": {
          "policyId": { "type": "string" },
          "version": { "type": ["string", "null"] },
          "result": { "type": "string" },
          "detail": { "type": ["string", "null"] },
          "source": { "enum": ["RULE_ENGINE"] }
        }
      }
    },
    "missingInformation": { "type": "array", "items": { "type": "string" } },
    "dataQuality": {
      "type": "object",
      "required": ["score", "issues"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "summary"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "erpPayload": {
      "type": "object",
      "required": ["action", "approvalLevel", "costCenter", "requestId"],
      "properties": {
        "action": { "enum": ["AUTO_APPROVE", "REJECT", "ROUTE_FOR_APPROVAL", "RETURN_TO_REQUESTER"] },
        "approvalLevel": { "type": "integer", "minimum": 0 },
        "costCenter": { "type": ["string", "null"] },
        "requestId": { "type": "string" }
      }
    },
    "audit": {
      "type": "object",
      "required": ["traceId", "decisionId", "decidedBy", "skillVersions", "tokens", "estimatedCostUsd", "latencyMs"],
      "properties": {
        "traceId": { "type": "string" },
        "decisionId": { "type": "string" },
        "decidedBy": { "enum": ["AGENT", "RULE_ENGINE", "VALIDATOR_OVERRIDE", "COMPLIANCE_OVERRIDE", "FALLBACK"] },
        "skillVersions": { "type": "object" },
        "model": { "type": ["string", "null"] },
        "tokens": { "type": "object" },
        "estimatedCostUsd": { "type": "number", "minimum": 0 },
        "latencyMs": { "type": "integer", "minimum": 0 },
        "llmCalls": { "type": "integer", "minimum": 0 },
        "fallbackReason": { "type": ["string", "null"] },
        "guardrailEvents": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
